            <include>Dimension_DialogFullMenu</include>
            <include>Animation_BounceIn_Dialog</include>
            <include content="Part_Background_Panel">
                <param name="dialog_size">Dimension_DialogFullMenu</param>
            </include>

            <!-- Signed out: how to get an account -->
            <control type="group">
                <visible>!RetroPlayer.AchievementsLoggedIn | !Player.HasGame</visible>
                <include>Size_Dialog_Pad</include>
                <control type="group">
                    <include>Size_Group_Head</include>
                    <include content="Part_HeadText">
                        <param name="id">9998</param>
                        <param name="label">$LOCALIZE[35287]</param>
                    </include>
                    <include>Part_CloseButton</include>
                    <include>Part_Line</include>
                </control>
                <control type="group">
                    <include>Size_Group_Body</include>
                    <control type="label">
                        <top>10</top>
                        <height>50</height>
                        <align>center</align>
                        <font>font_main_bold</font>
                        <textcolor>dialog_fg_90</textcolor>
                        <label>$LOCALIZE[35367]</label>
                    </control>
                    <control type="image">
                        <top>80</top>
                        <centerleft>50%</centerleft>
                        <width>480</width>
                        <height>480</height>
                        <aspectratio>keep</aspectratio>
                        <texture>special://xbmc/media/qr/games/retroachievements.png</texture>
                    </control>
                    <control type="label">
                        <top>580</top>
                        <height>50</height>
                        <align>center</align>
                        <font>font_main</font>
                        <textcolor>dialog_fg_70</textcolor>
                        <label>$LOCALIZE[35368]</label>
                    </control>
                </control>
            </control>

            <!-- Content -->
            <control type="group" id="8000">
                <visible>RetroPlayer.AchievementsLoggedIn + Player.HasGame</visible>
                <include>Size_Dialog_Pad</include>

                <control type="group">
                    <right>440</right>
                    <control type="group">
                        <include>Size_Group_Head</include>
                        <include content="Part_HeadText">
                            <param name="id">9999</param>
                            <param name="label">$INFO[Window.Property(Header)]</param>
                            <param name="right">constant_dialog_pad</param>
                        </include>
                        <include content="Part_ItemPage">
                            <param name="id">3</param>
                            <param name="items_label">$LOCALIZE[35287]</param>
                        </include>
                        <include>Part_Line</include>
                    </control>
                    <control type="group">
                        <include>Size_Group_Body</include>
                        <include content="List_DialogSelect">
                            <param name="id">3</param>
                            <param name="itemlayout_include">Layout_GameAchievement</param>
                            <param name="item_height">128</param>
                            <pagecontrol>61</pagecontrol>
                            <onright>61</onright>
                            <include>Size_Grouplist_Pad</include>
                        </include>
                        <include content="Part_Scrollbar_Max">
                            <param name="id">61</param>
                            <param name="inset">false</param>
                            <onleft>3</onleft>
                            <onright>9000</onright>
                        </include>
                    </control>
                </control>

                <control type="group">
                    <width>440</width>
                    <right>0</right>
                    <include>Part_Panel</include>
                    <control type="grouplist" id="9000">
                        <onleft>3</onleft>
                        <itemgap>20</itemgap>
                        <orientation>vertical</orientation>
                        <include>Size_Grouplist_Pad</include>
                        <include>DialogGameAchievements_Items</include>
                    </control>
                </control>
            </control>
        </control>
    </include>

