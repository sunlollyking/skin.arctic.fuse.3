<?xml version="1.0" encoding="UTF-8"?>
<window>
    <onload>ClearProperty(OSDRelaunchFullscreen,Home)</onload>
    <controls>
        <control type="grouplist" id="0">
            <orientation>vertical</orientation>
            <centertop>100</centertop>
            <height>120</height>
            <left>80</left>
            <include content="Overlay_InfoLabel">
                <param name="id">10</param>
                <textcolor>panel_fg_100</textcolor>
                <textoffsetx>10</textoffsetx>
                <font>font_mini</font>
            </include>
            <include content="Overlay_InfoLabel">
                <param name="id">11</param>
                <textcolor>panel_fg_100</textcolor>
                <textoffsetx>10</textoffsetx>
                <font>font_mini</font>
            </include>
            <include content="Overlay_InfoLabel">
                <param name="id">12</param>
                <textcolor>panel_fg_100</textcolor>
                <textoffsetx>10</textoffsetx>
                <font>font_mini</font>
            </include>
        </control>

        <control type="group">
            <description>
                RetroAchievements challenge indicator. Shown while the player is inside an
                achievement Kodi is watching, so it has to sit over the running game rather
                than in the OSD, which is not on screen while playing.

                The title being empty is what keeps this hidden, which also covers a Kodi
                build without the achievements work, where the info labels are unknown.
            </description>
            <right>60</right>
            <top>60</top>
            <width>420</width>
            <height>96</height>
            <visible>!String.IsEmpty(RetroPlayer.AchievementsChallengeTitle)</visible>
            <animation effect="fade" time="200">VisibleChange</animation>

            <control type="image">
                <left>0</left>
                <top>0</top>
                <width>420</width>
                <height>96</height>
                <texture border="8" colordiffuse="main_bg_70">common/white.png</texture>
            </control>

            <control type="image">
                <description>The achievement's badge, as the server serves it</description>
                <left>12</left>
                <top>12</top>
                <width>72</width>
                <height>72</height>
                <aspectratio>keep</aspectratio>
                <texture background="true">$INFO[RetroPlayer.AchievementsChallengeBadge]</texture>
            </control>

            <control type="label">
                <left>98</left>
                <top>12</top>
                <width>310</width>
                <height>72</height>
                <aligny>center</aligny>
                <font>font_mini</font>
                <textcolor>main_fg_100</textcolor>
                <label>$INFO[RetroPlayer.AchievementsChallengeTitle]</label>
                <wrapmultiline>true</wrapmultiline>
            </control>
        </control>

        <control type="group">
            <description>
                Measured achievement indicator. Some achievements are counted rather than
                simply locked or unlocked - "collect 180 rings" - and this shows how far
                along one is while the player works towards it.

                The title being empty is what keeps this hidden, which also covers a Kodi
                build without the work, where the info labels are unknown.
            </description>
            <right>60</right>
            <top>60</top>
            <width>420</width>
            <height>96</height>
            <visible>!String.IsEmpty(RetroPlayer.AchievementsIndicatorTitle)</visible>
            <animation effect="fade" time="200">VisibleChange</animation>
            <animation effect="slide" end="0,108" time="0" condition="!String.IsEmpty(RetroPlayer.AchievementsChallengeTitle)">Conditional</animation>

            <control type="image">
                <left>0</left>
                <top>0</top>
                <width>420</width>
                <height>96</height>
                <texture border="8" colordiffuse="main_bg_70">common/white.png</texture>
            </control>

            <control type="image">
                <description>The achievement's badge, as the server serves it</description>
                <left>12</left>
                <top>12</top>
                <width>72</width>
                <height>72</height>
                <aspectratio>keep</aspectratio>
                <texture background="true">$INFO[RetroPlayer.AchievementsIndicatorBadge]</texture>
            </control>

            <control type="label">
                <left>98</left>
                <top>10</top>
                <width>210</width>
                <height>40</height>
                <aligny>center</aligny>
                <font>font_mini</font>
                <textcolor>main_fg_100</textcolor>
                <label>$INFO[RetroPlayer.AchievementsIndicatorTitle]</label>
                <scroll>true</scroll>
                <scrollsuffix>   </scrollsuffix>
            </control>

            <control type="label">
                <description>How far along, as the client counts it</description>
                <right>12</right>
                <top>10</top>
                <width>90</width>
                <height>40</height>
                <align>right</align>
                <aligny>center</aligny>
                <font>font_mini</font>
                <textcolor>main_fg_70</textcolor>
                <label>$INFO[RetroPlayer.AchievementsIndicatorProgress]</label>
            </control>

            <control type="progress">
                <description>
                    The same figure as a bar. Driven by the percentage rather than by
                    parsing "13/180" back into numbers.
                </description>
                <left>98</left>
                <top>58</top>
                <width>310</width>
                <height>8</height>
                <info>RetroPlayer.AchievementsIndicatorPercent</info>
            </control>
        </control>

        <control type="group">
            <description>
                Leaderboard tracker. While an attempt at a leaderboard runs, the client
                publishes the value as it stands - the lap time so far, the score so far -
                and this shows it.

                The value being empty is what keeps this hidden, which also covers a Kodi
                build without the leaderboard work, where the info label is unknown.

                Sits under the challenge indicator, and slides up to where that one sits
                when there is none.
            </description>
            <right>60</right>
            <top>60</top>
            <width>420</width>
            <height>64</height>
            <visible>!String.IsEmpty(RetroPlayer.LeaderboardTracker)</visible>
            <animation effect="fade" time="200">VisibleChange</animation>
            <animation effect="slide" end="0,108" time="0" condition="!String.IsEmpty(RetroPlayer.AchievementsChallengeTitle) + String.IsEmpty(RetroPlayer.AchievementsIndicatorTitle)">Conditional</animation>
            <animation effect="slide" end="0,108" time="0" condition="String.IsEmpty(RetroPlayer.AchievementsChallengeTitle) + !String.IsEmpty(RetroPlayer.AchievementsIndicatorTitle)">Conditional</animation>
            <animation effect="slide" end="0,216" time="0" condition="!String.IsEmpty(RetroPlayer.AchievementsChallengeTitle) + !String.IsEmpty(RetroPlayer.AchievementsIndicatorTitle)">Conditional</animation>

            <control type="image">
                <left>0</left>
                <top>0</top>
                <width>420</width>
                <height>64</height>
                <texture border="8" colordiffuse="main_bg_70">common/white.png</texture>
            </control>

            <control type="label">
                <description>The value as it stands, formatted by the client</description>
                <left>14</left>
                <top>0</top>
                <width>392</width>
                <height>64</height>
                <align>center</align>
                <aligny>center</aligny>
                <font>font_midi_bold</font>
                <textcolor>main_fg_100</textcolor>
                <label>$INFO[RetroPlayer.LeaderboardTracker]</label>
            </control>
        </control>
    </controls>
</window>