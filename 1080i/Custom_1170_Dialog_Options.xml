<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog" id="1170">
    <defaultcontrol always="true">7000</defaultcontrol>
    <!-- Kids mode: no options menu; Kodi's own settings ask for the master lock code -->
    <onload condition="Skin.HasSetting(KidsMode)">Dialog.Close(1170,true)</onload>
    <onload condition="Skin.HasSetting(KidsMode)">ActivateWindow(settings)</onload>
    <onload>AlarmClock(refocus,SetFocus(7021),00:00,silent)</onload>
    <onload>SetProperty(TMDbHelper.ServicePause,True)</onload>
    <zorder>1100</zorder>
    <controls>
        <include content="DialogView">
            <param name="header">$LOCALIZE[33063][COLOR=dialog_fg_30] — [/COLOR]$INFO[System.Time]</param>
            <param name="include_listitems">skinvariables-powermenu-staticitems</param>
        </include>
    </controls>
</window>