<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog">
    <!-- No default control: the results list is empty when the dialog opens,
         and the dialog focuses it once there are results -->
    <controls>
        <include>Part_Dim_Overlay</include>
        <control type="group">
            <description>
                Offers a manual for a game that has none beside it. Kodi asks whichever
                add-on says it can provide manuals; nothing here knows about any service.

                There is normally one answer, so the question is not which manual to
                take but whether this is the right game and worth the download. It is
                described rather than listed.
            </description>
            <include>Dimension_DialogWideMenu</include>
            <include>Animation_BounceIn_Dialog</include>
            <include content="Part_Background_Panel">
                <param name="dialog_size">Dimension_DialogWideMenu</param>
            </include>
            <control type="group" id="8000">
                <include>Size_Dialog_Pad</include>
                <control type="group">
                    <include>Size_Group_Head</include>
                    <include content="Part_HeadText">
                        <param name="id">0</param>
                        <param name="label">$LOCALIZE[35317]</param>
                    </include>
                    <include>Part_CloseButton</include>
                </control>

                <control type="group">
                    <include>Size_Group_Body</include>

                    <control type="label">
                        <description>Which game this is about</description>
                        <left>40</left>
                        <right>40</right>
                        <height>40</height>
                        <font>font_mini</font>
                        <textcolor>dialog_fg_90</textcolor>
                        <label>$INFO[Window.Property(Manuals.Game)]</label>
                    </control>

                    <control type="label">
                        <description>Searching, downloading, or nothing found</description>
                        <left>40</left>
                        <right>40</right>
                        <top>60</top>
                        <bottom>120</bottom>
                        <align>center</align>
                        <aligny>center</aligny>
                        <font>font_main</font>
                        <textcolor>dialog_fg_90</textcolor>
                        <wrapmultiline>true</wrapmultiline>
                        <label>$INFO[Window.Property(Manuals.Status)]$INFO[Window.Property(Manuals.Progress),  ,%]</label>
                        <visible>!String.IsEmpty(Window.Property(Manuals.Status))</visible>
                    </control>

                    <control type="group">
                        <description>What the catalogue holds for this game</description>
                        <top>60</top>
                        <visible>String.IsEmpty(Window.Property(Manuals.Status))</visible>

                        <control type="image">
                            <description>The box settles "is this my game" well before the text does</description>
                            <left>40</left>
                            <width>200</width>
                            <height>280</height>
                            <aspectratio align="center" aligny="top">keep</aspectratio>
                            <texture fallback="DefaultAddonGame.png">$INFO[Container(110).ListItem.Art(poster)]</texture>
                        </control>

                        <control type="group">
                            <left>280</left>
                            <right>40</right>
                            <control type="label">
                                <height>40</height>
                                <font>font_main_bold</font>
                                <textcolor>dialog_fg_90</textcolor>
                                <scroll>true</scroll>
                                <label>$INFO[Container(110).ListItem.Label]</label>
                            </control>
                            <control type="label">
                                <description>Which machine, as a tagline under the title</description>
                                <top>40</top>
                                <height>40</height>
                                <font>font_mini</font>
                                <textcolor>$VAR[ColorHighlight]</textcolor>
                                <label>$INFO[Container(110).ListItem.Property(manual.system)]</label>
                            </control>
                            <control type="grouplist">
                                <description>
                                    A grouplist so that a field the catalogue has nothing for
                                    closes up rather than leaving a labelled blank
                                </description>
                                <top>80</top>
                                <height>200</height>
                                <itemgap>0</itemgap>
                                <orientation>vertical</orientation>
                                <include content="GameManualDetail">
                                    <param name="label" value="$LOCALIZE[20026]" />
                                    <param name="property" value="manual.region" />
                                </include>
                                <include content="GameManualDetail">
                                    <param name="label" value="$LOCALIZE[562]" />
                                    <param name="property" value="manual.year" />
                                </include>
                                <include content="GameManualDetail">
                                    <param name="label" value="$LOCALIZE[35727]" />
                                    <param name="property" value="manual.publisher" />
                                </include>
                                <include content="GameManualDetail">
                                    <param name="label" value="$LOCALIZE[35728]" />
                                    <param name="property" value="manual.developer" />
                                </include>
                                <include content="GameManualDetail">
                                    <param name="label" value="$LOCALIZE[515]" />
                                    <param name="property" value="manual.genre" />
                                </include>
                            </control>
                        </control>

                        <control type="group">
                            <top>320</top>
                            <height>160</height>
                            <include content="List_Dialog">
                                <param name="id">110</param>
                                <param name="itemlayout_include">List_Layout_Dialog_GameManuals</param>
                                <include>Size_Grouplist_Pad</include>
                                <onup>110</onup>
                                <ondown>110</ondown>
                            </include>
                        </control>
                    </control>
                </control>

                <control type="group">
                    <description>
                        Which add-on answered. Shown rather than made selectable, because with
                        one provider installed there is nothing to pick between.
                    </description>
                    <visible>!String.IsEmpty(Window.Property(Manuals.Provider))</visible>
                    <include content="Part_InfoText">
                        <param name="label">$LOCALIZE[35319]: $INFO[Window.Property(Manuals.Provider)]</param>
                    </include>
                </control>

                <control type="list" id="120">
                    <description>
                        The providers themselves, kept off screen. Kodi needs the control to
                        bind them to; switching between them only matters once there is more
                        than one installed.
                    </description>
                    <width>1</width>
                    <height>1</height>
                    <visible>false</visible>
                    <itemlayout height="1" width="1" />
                    <focusedlayout height="1" width="1" />
                </control>
            </control>
        </control>
    </controls>
</window>
