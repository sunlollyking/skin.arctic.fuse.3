<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog">
    <!-- Not "always": the results list is hidden while a status is showing,
         and forcing focus onto a hidden control fails and logs an error -->
    <defaultcontrol>110</defaultcontrol>
    <controls>
        <control type="group">
            <description>
                Offers a manual for a game that has none beside it. Kodi asks whichever
                add-on says it can provide manuals; nothing here knows about any service.

                There is normally one answer, so the question is not which manual to
                take but whether this is the right game and worth the download. It is
                described rather than listed.
            </description>
            <centerleft>50%</centerleft>
            <centertop>50%</centertop>
            <width>1000</width>
            <height>680</height>
            <animation effect="fade" time="200">WindowOpen</animation>
            <animation effect="fade" time="200">WindowClose</animation>

            <control type="image">
                <left>0</left>
                <top>0</top>
                <width>100%</width>
                <height>100%</height>
                <texture border="12" colordiffuse="dialog_bg_100">common/white.png</texture>
            </control>

            <control type="label">
                <left>40</left>
                <top>24</top>
                <width>920</width>
                <height>56</height>
                <align>center</align>
                <aligny>center</aligny>
                <font>font_main_bold</font>
                <textcolor>panel_fg_100</textcolor>
                <label>$LOCALIZE[35318]</label>
            </control>

            <control type="label">
                <description>Which game this is about</description>
                <left>40</left>
                <top>82</top>
                <width>920</width>
                <height>34</height>
                <align>center</align>
                <aligny>center</aligny>
                <font>font_tiny</font>
                <textcolor>panel_fg_50</textcolor>
                <label>$INFO[Window.Property(Manuals.Game)]</label>
            </control>

            <control type="label">
                <description>Searching, or nothing found</description>
                <left>60</left>
                <top>130</top>
                <width>880</width>
                <height>390</height>
                <align>center</align>
                <aligny>center</aligny>
                <font>font_mini</font>
                <textcolor>panel_fg_100</textcolor>
                <label>$INFO[Window.Property(Manuals.Status)]</label>
                <visible>!String.IsEmpty(Window.Property(Manuals.Status))</visible>
            </control>

            <control type="group">
                <description>What the catalogue holds for this game</description>
                <visible>String.IsEmpty(Window.Property(Manuals.Status))</visible>

                <control type="image">
                    <description>The box settles "is this my game" well before the text does</description>
                    <left>50</left>
                    <top>132</top>
                    <width>240</width>
                    <height>330</height>
                    <aspectratio align="center" aligny="top">keep</aspectratio>
                    <texture fallback="DefaultAddonGame.png">$INFO[Container(110).ListItem.Art(poster)]</texture>
                </control>

                <control type="label">
                    <left>324</left>
                    <top>128</top>
                    <width>620</width>
                    <height>48</height>
                    <aligny>center</aligny>
                    <font>font_head_bold</font>
                    <textcolor>panel_fg_100</textcolor>
                    <scroll>true</scroll>
                    <label>$INFO[Container(110).ListItem.Label]</label>
                </control>

                <control type="label">
                    <description>
                        Which machine, as a tagline under the title. Everything else is a
                        labelled field below: a player deciding whether to fetch this needs
                        to read the values, not decode a line of text with separators in it.
                    </description>
                    <left>324</left>
                    <top>180</top>
                    <width>620</width>
                    <height>32</height>
                    <aligny>center</aligny>
                    <font>font_mini</font>
                    <textcolor>$VAR[ColorHighlight]</textcolor>
                    <label>$INFO[Container(110).ListItem.Property(manual.system)]</label>
                </control>

                <control type="grouplist">
                    <description>
                        A grouplist so that a field the catalogue has nothing for closes up
                        rather than leaving a labelled blank
                    </description>
                    <left>324</left>
                    <top>220</top>
                    <width>620</width>
                    <height>264</height>
                    <itemgap>4</itemgap>
                    <orientation>vertical</orientation>

                    <include content="GameManualDetail">
                        <param name="label" value="$LOCALIZE[20026]" />
                        <param name="property" value="manual.region" />
                    </include>
                    <include content="GameManualDetail">
                        <param name="label" value="$LOCALIZE[562]" />
                        <param name="property" value="manual.year" />
                    </include>
                    <include content="GameManualDetail">
                        <param name="label" value="$LOCALIZE[35327]" />
                        <param name="property" value="manual.publisher" />
                    </include>
                    <include content="GameManualDetail">
                        <param name="label" value="$LOCALIZE[35328]" />
                        <param name="property" value="manual.developer" />
                    </include>
                    <include content="GameManualDetail">
                        <param name="label" value="$LOCALIZE[515]" />
                        <param name="property" value="manual.genre" />
                    </include>
                    <include content="GameManualDetail">
                        <param name="label" value="$LOCALIZE[21802]" />
                        <param name="property" value="manual.size" />
                    </include>
                </control>
            </control>

            <control type="group">
                <description>
                    Download progress. A manual can be a hundred megabytes, and a silent
                    wait is indistinguishable from Kodi having hung.
                </description>
                <visible>!String.IsEmpty(Window.Property(Manuals.Downloading))</visible>


                <control type="label">
                    <left>250</left>
                    <top>402</top>
                    <width>500</width>
                    <height>36</height>
                    <align>center</align>
                    <aligny>center</aligny>
                    <font>font_mini</font>
                    <textcolor>panel_fg_70</textcolor>
                    <label>$INFO[Window.Property(Manuals.Progress)]%</label>
                </control>
            </control>

            <control type="list" id="110">
                <left>50</left>
                <top>498</top>
                <width>900</width>
                <height>128</height>
                <onup>110</onup>
                <ondown>110</ondown>
                <visible>String.IsEmpty(Window.Property(Manuals.Status))</visible>
                <scrolltime tween="sine" easing="out">200</scrolltime>

                <itemlayout height="64" width="900">
                    <control type="label">
                        <left>24</left>
                        <top>0</top>
                        <width>700</width>
                        <height>64</height>
                        <aligny>center</aligny>
                        <font>font_mini</font>
                        <textcolor>panel_fg_100</textcolor>
                        <label>$INFO[ListItem.Label]</label>
                    </control>
                    <control type="label">
                        <left>748</left>
                        <top>0</top>
                        <width>128</width>
                        <height>64</height>
                        <align>right</align>
                        <aligny>center</aligny>
                        <font>font_mini</font>
                        <textcolor>panel_fg_70</textcolor>
                        <label>$INFO[ListItem.Property(manual.size)]</label>
                    </control>
                </itemlayout>

                <focusedlayout height="64" width="900">
                    <control type="image">
                        <left>0</left>
                        <top>2</top>
                        <width>900</width>
                        <height>60</height>
                        <texture border="6" colordiffuse="$VAR[ColorSelected]">common/white.png</texture>
                    </control>
                    <control type="label">
                        <left>24</left>
                        <top>0</top>
                        <width>700</width>
                        <height>64</height>
                        <aligny>center</aligny>
                        <font>font_mini</font>
                        <textcolor>$VAR[ColorSelectedInverted]</textcolor>
                        <label>$INFO[ListItem.Label]</label>
                    </control>
                    <control type="label">
                        <description>
                            The focused row says what pressing it does, since the panel above
                            has already said what the manual is
                        </description>
                        <left>748</left>
                        <top>0</top>
                        <width>128</width>
                        <height>64</height>
                        <align>right</align>
                        <aligny>center</aligny>
                        <font>font_tiny</font>
                        <textcolor>$VAR[ColorSelectedInverted]</textcolor>
                        <label>$LOCALIZE[33003]</label>
                    </control>
                </focusedlayout>
            </control>

            <control type="label">
                <description>
                    Which add-on answered. Shown rather than made selectable, because with
                    one provider installed there is nothing to pick between.
                </description>
                <left>50</left>
                <top>630</top>
                <width>900</width>
                <height>36</height>
                <align>center</align>
                <aligny>center</aligny>
                <font>font_tiny</font>
                <textcolor>panel_fg_50</textcolor>
                <label>$LOCALIZE[35320]  $INFO[Window.Property(Manuals.Provider)]</label>
                <visible>!String.IsEmpty(Window.Property(Manuals.Provider))</visible>
            </control>

            <control type="list" id="120">
                <description>
                    The providers themselves, kept off screen. Kodi needs the control to
                    bind them to; switching between them only matters once there is more
                    than one installed.
                </description>
                <left>50</left>
                <top>630</top>
                <width>900</width>
                <height>1</height>
                <visible>false</visible>
                <itemlayout height="1" width="900"/>
                <focusedlayout height="1" width="900"/>
            </control>
        </control>
    </controls>
</window>
